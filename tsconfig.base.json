{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@template/contracts": ["packages/contracts/src/index.ts"],
      "@template/api-client-ts": ["packages/api-client-ts/src/index.ts"],
      "@template/design-system/styles.css": ["packages/design-system/src/styles.css"]
    }
  }
}
